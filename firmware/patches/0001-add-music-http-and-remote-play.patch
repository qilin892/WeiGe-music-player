+#ifndef MUSIC_HTTP_SERVER_H
+#define MUSIC_HTTP_SERVER_H
+
+#include <string>
+
+/**
+ * 局域网点播接口。
+ *
+ * 设备已经具备「从 HTTP 拉 OGG/Opus 并播放」的能力（notify_player），
+ * 这里只是给它开一个局域网入口，方便手机/电脑直接把音频地址推给它：
+ *
+ *   GET /play?url=<urlencoded ogg 地址>&title=<可选>
+ *   GET /stop
+ *   GET /status
+ *   GET /          简易点播页
+ *
+ * 只在网络就绪后启动，端口 8080（可用 Kconfig 改）。
+ */
+class MusicHttpServer {
+public:
+    static MusicHttpServer& GetInstance();
+
+    void Start(int port);
+    void Stop();
+    bool IsRunning() const { return started_; }
+
+private:
+    MusicHttpServer() = default;
+
+    bool started_ = false;
+    void* server_ = nullptr;  // httpd_handle_t
+};
+
+#endif  // MUSIC_HTTP_SERVER_H
