diff --git a/main/music_http_server.cc b/main/music_http_server.cc
new file mode 100644
index 0000000..48c5179
--- /dev/null
+++ b/main/music_http_server.cc
@@ -0,0 +1,228 @@
+#include "music_http_server.h"
+
+#include <cstring>
+#include <string>
+
+#include <esp_http_server.h>
+#include <esp_log.h>
+#include <esp_netif.h>
+
+#include "application.h"
+
+#define TAG "MusicHttp"
+
+namespace {
+
+httpd_handle_t g_server = nullptr;
+
+/** 把 %XX 还原成字节，'+' 还原成空格 */
+std::string UrlDecode(const char* src, size_t len) {
+    std::string out;
+    out.reserve(len);
+    for (size_t i = 0; i < len; ++i) {
+        char c = src[i];
+        if (c == '+') {
+            out.push_back(' ');
+        } else if (c == '%' && i + 2 < len) {
+            auto hex = [](char h) -> int {
+                if (h >= '0' && h <= '9') return h - '0';
+                if (h >= 'a' && h <= 'f') return h - 'a' + 10;
+                if (h >= 'A' && h <= 'F') return h - 'A' + 10;
+                return -1;
+            };
+            int hi = hex(src[i + 1]);
+            int lo = hex(src[i + 2]);
+            if (hi >= 0 && lo >= 0) {
+                out.push_back(static_cast<char>((hi << 4) | lo));
+                i += 2;
+            } else {
+                out.push_back(c);
+            }
+        } else {
+            out.push_back(c);
+        }
+    }
+    return out;
+}
+
+/** 取查询参数，取不到返回空串 */
+std::string GetQueryValue(httpd_req_t* req, const char* key) {
+    char buf[512];
+    size_t len = httpd_req_get_url_query_len(req) + 1;
+    if (len <= 1) {
+        return {};
+    }
+    if (len > sizeof(buf)) {
+        len = sizeof(buf);
+    }
+    if (httpd_req_get_url_query_str(req, buf, len) != ESP_OK) {
+        return {};
+    }
+    char value[768];
+    if (httpd_query_key_value(buf, key, value, sizeof(value)) != ESP_OK) {
+        return {};
+    }
+    return UrlDecode(value, strlen(value));
+}
+
+void SendJson(httpd_req_t* req, const std::string& body, const char* status = "200 OK") {
+    httpd_resp_set_status(req, status);
+    httpd_resp_set_type(req, "application/json; charset=utf-8");
+    httpd_resp_send(req, body.c_str(), body.size());
+}
+
+const char* StateName() {
+    switch (Application::GetInstance().GetDeviceState()) {
+        case kDeviceStateIdle:
+            return "idle";
+        case kDeviceStateConnecting:
+            return "connecting";
+        case kDeviceStateListening:
+            return "listening";
+        case kDeviceStateSpeaking:
+            return "speaking";
+        case kDeviceStateNotifying:
+            return "notifying";
+        case kDeviceStateActivating:
+            return "activating";
+        default:
+            return "other";
+    }
+}
+
+esp_err_t HandlePlay(httpd_req_t* req) {
+    auto url = GetQueryValue(req, "url");
+    if (url.empty()) {
+        SendJson(req, "{\"ok\":false,\"error\":\"missing url\"}", "400 Bad Request");
+        return ESP_OK;
+    }
+    if (url.rfind("http://", 0) != 0 && url.rfind("https://", 0) != 0) {
+        SendJson(req, "{\"ok\":false,\"error\":\"url must be http(s)\"}", "400 Bad Request");
+        return ESP_OK;
+    }
+
+    // 注意：这里拿到的是 httpd 任务，PlayMusic 内部会 Schedule 到主线程
+    bool started = Application::GetInstance().PlayMusic(url);
+    if (!started) {
+        SendJson(req, "{\"ok\":false,\"error\":\"device busy\"}", "409 Conflict");
+        return ESP_OK;
+    }
+    std::string body = "{\"ok\":true,\"url\":\"" + url + "\"}";
+    SendJson(req, body);
+    return ESP_OK;
+}
+
+esp_err_t HandleStop(httpd_req_t* req) {
+    Application::GetInstance().StopMusic();
+    SendJson(req, "{\"ok\":true}");
+    return ESP_OK;
+}
+
+esp_err_t HandleStatus(httpd_req_t* req) {
+    std::string body = std::string("{\"ok\":true,\"state\":\"") + StateName() + "\"}";
+    SendJson(req, body);
+    return ESP_OK;
+}
+
+esp_err_t HandleRoot(httpd_req_t* req) {
+    static const char* page = R"HTML(<!DOCTYPE html>
+<html lang="zh-CN"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>小智点播</title>
+<style>
+body{font-family:system-ui,-apple-system,sans-serif;margin:0;padding:24px;background:#f6f7f9;color:#1a1a1a}
+h1{font-size:18px;margin:0 0 16px}
+input,button{width:100%;box-sizing:border-box;padding:12px;font-size:15px;border-radius:10px;border:1px solid #d5d7db;margin-bottom:12px}
+button{background:#1f6feb;color:#fff;border:none;font-weight:500}
+#log{white-space:pre-wrap;font-size:13px;color:#555;margin-top:12px}
+</style></head><body>
+<h1>小智点播（粘贴 OGG/Opus 地址）</h1>
+<input id="u" placeholder="http://192.168.x.x:8090/media/xxx.ogg">
+<button onclick="play()">播放</button>
+<button onclick="fetch('/stop').then(r=>r.text()).then(t=>log(t))" style="background:#8b949e">停止</button>
+<div id="log"></div>
+<script>
+function log(t){document.getElementById('log').textContent=t}
+function play(){
+  const u=document.getElementById('u').value.trim();
+  if(!u){log('请先填地址');return}
+  log('发送中…');
+  fetch('/play?url='+encodeURIComponent(u)).then(r=>r.text()).then(log).catch(e=>log('失败: '+e));
+}
+</script></body></html>)HTML";
+
+    httpd_resp_set_type(req, "text/html; charset=utf-8");
+    httpd_resp_send(req, page, HTTPD_RESP_USE_STRLEN);
+    return ESP_OK;
+}
+
+std::string LocalIp() {
+    esp_netif_ip_info_t ip_info{};
+    esp_netif_t* netif = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    if (netif == nullptr || esp_netif_get_ip_info(netif, &ip_info) != ESP_OK) {
+        return {};
+    }
+    char buf[16];
+    snprintf(buf, sizeof(buf), IPSTR, IP2STR(&ip_info.ip));
+    return buf;
+}
+
+}  // namespace
+
+MusicHttpServer& MusicHttpServer::GetInstance() {
+    static MusicHttpServer instance;
+    return instance;
+}
+
+void MusicHttpServer::Start(int port) {
+    if (started_) {
+        return;
+    }
+
+    httpd_config_t config = HTTPD_DEFAULT_CONFIG();
+    config.server_port = port;
+    config.ctrl_port = port + 1;
+    config.lru_purge_enable = true;
+    config.max_uri_handlers = 8;
+    // 默认栈 4KB 对带 JSON 拼装的处理器偏紧
+    config.stack_size = 6144;
+
+    httpd_handle_t server = nullptr;
+    esp_err_t err = httpd_start(&server, &config);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "httpd_start failed: %s", esp_err_to_name(err));
+        return;
+    }
+
+    httpd_uri_t root = {.uri = "/", .method = HTTP_GET, .handler = HandleRoot, .user_ctx = nullptr};
+    httpd_uri_t play = {.uri = "/play", .method = HTTP_GET, .handler = HandlePlay, .user_ctx = nullptr};
+    httpd_uri_t stop = {.uri = "/stop", .method = HTTP_GET, .handler = HandleStop, .user_ctx = nullptr};
+    httpd_uri_t status = {.uri = "/status", .method = HTTP_GET, .handler = HandleStatus, .user_ctx = nullptr};
+    httpd_register_uri_handler(server, &root);
+    httpd_register_uri_handler(server, &play);
+    httpd_register_uri_handler(server, &stop);
+    httpd_register_uri_handler(server, &status);
+
+    g_server = server;
+    server_ = server;
+    started_ = true;
+
+    auto ip = LocalIp();
+    if (!ip.empty()) {
+        ESP_LOGI(TAG, "点播页: http://%s:%d/", ip.c_str(), port);
+    } else {
+        ESP_LOGI(TAG, "已启动，端口 %d（IP 尚未就绪）", port);
+    }
+}
+
+void MusicHttpServer::Stop() {
+    if (!started_) {
+        return;
+    }
+    if (g_server != nullptr) {
+        httpd_stop(g_server);
+        g_server = nullptr;
+    }
+    server_ = nullptr;
+    started_ = false;
+}
