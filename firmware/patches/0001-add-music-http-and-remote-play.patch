+bool Application::PlayMusic(const std::string& url) {
+    if (url.empty()) {
+        ESP_LOGW(TAG, "PlayMusic: empty url");
+        return false;
+    }
+
+    // 语音点歌时设备必然停在 listening/speaking（正在播 TTS 回复），
+    // 如果这里要求 idle，用户就永远点不响。放宽到「对话中也能插播」，
+    // 真正的状态收敛放到主线程里做。
+    auto state = GetDeviceState();
+    if (state != kDeviceStateIdle && state != kDeviceStateListening &&
+        state != kDeviceStateSpeaking && state != kDeviceStateNotifying) {
+        ESP_LOGW(TAG, "PlayMusic ignored: state=%d", static_cast<int>(state));
+        return false;
+    }
+
+    // StartNotification 会改设备状态、动显示和音频资源，必须回到主线程执行
+    ESP_LOGI(TAG, "PlayMusic: %s (from state=%d)", url.c_str(), static_cast<int>(state));
+    Schedule([this, audio_url = url]() mutable {
+        auto current = GetDeviceState();
+
+        // 正在放别的歌：先停掉，再按下面的流程重新起播
+        if (current == kDeviceStateNotifying) {
+            StopNotification();
+            current = GetDeviceState();
+        }
+
+        // 仍在对话中：主动结束这一轮。
+        // 状态机只允许 listening/speaking -> idle -> notifying，不能一步跳到 notifying。
+        if (current != kDeviceStateIdle) {
+            if (protocol_ && protocol_->IsAudioChannelOpened()) {
+                protocol_->CloseAudioChannel();
+            }
+            audio_service_.EnableVoiceProcessing(false);
+            if (!SetDeviceState(kDeviceStateIdle)) {
+                ESP_LOGW(TAG, "PlayMusic: cannot fall back to idle");
+                return;
+            }
+            // 等 STATE_CHANGED 处理完，避免和 StartNotification 抢音频资源
+            vTaskDelay(pdMS_TO_TICKS(150));
+        }
+
+        StartNotification(std::move(audio_url), {});
+    });
+    return true;
+}
+
+void Application::StopMusic() {
+    // 只要还有音频在播就停，不完全依赖状态机：
+    // 插播时关掉对话通道会让状态短暂回落，状态和音频可能不同步。
+    if (!notify_player_.IsBusy() && GetDeviceState() != kDeviceStateNotifying) {
+        return;
+    }
+    Schedule([this]() { StopNotification(); });
+}
